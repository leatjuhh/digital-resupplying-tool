# SECRET_KEY (VERPLICHT, geen fallback). Wordt gebruikt om JWT's te ondertekenen.
# De backend start bewust NIET zonder deze variabele (fail-fast). Gebruik een
# lange, willekeurige waarde, bijv. gegenereerd met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deel deze waarde nooit en commit hem nooit; zet hem in backend/.env (gitignored).
SECRET_KEY=

# Database-URL (optioneel). Laat leeg om de lokale backend/database.db te
# gebruiken (standaardgedrag). Overschrijf alleen wanneer de applicatie of een
# testrun tegen een andere database moet draaien, bijv.
# DATABASE_URL=sqlite:////absoluut/pad/naar/andere.db
# De backend-testsuite zet deze variabele automatisch naar een wegwerpdatabase
# (zie backend/conftest.py), zodat tests nooit de lokale database.db muteren.
DATABASE_URL=

# Assist mode voor ML-model integratie
# Opties: off | shadow | rank_assist
# - off: model niet actief
# - shadow: model scoort moves maar beïnvloedt volgorde niet (aanbevolen voor praktijktest)
# - rank_assist: model herschikt moves op combined_score (0.4 demand + 0.6 model)
ALGORITHM_ASSIST_MODE=shadow

# Pad naar de root van de algoritmedata-directory
# Moet bestaan en de structuur {jaar}/week_{week}/combined.json + aggregate/model_artifacts.json bevatten
# Laat leeg om automatisch backend/algorithm_data/ binnen deze repo te gebruiken.
# Alleen invullen als de dataset op een andere locatie staat.
EXTERNAL_ALGORITHM_DATA_ROOT=
